{
  "should_trigger": [
    {
      "id": "bench-cmd",
      "prompt": "agent-bench.mjs routing.json faalt",
      "must_match_description": ["agent-bench.mjs", "routing.json"]
    }
  ],
  "should_not_trigger": [
