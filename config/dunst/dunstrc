# ChefBar / ChefGroep v2-look voor dunst (notificatie-daemon).
# Bron: .ulpi/design/chefbar-tray.md — warm off-white/basalt surface,
# hairline edge, 10px radius, General Sans body, amber rand bij critical.
# Installeren: `install.sh` (alleen als dunst bestaat) of handmatig kopiëren
# naar ~/.config/dunst/dunstrc.

[global]
    font = General Sans 10
    background = "#1B1A19"
    foreground = "#F5F3F0"
    frame_color = "#2A2927"
    separator_color = frame
    frame_width = 1
    corner_radius = 10
    padding = 10
    horizontal_padding = 12
    width = 360
    height = 100
    origin = top-right
    offset = 8x8
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    show_age_threshold = 60
    icon_position = off
    max_icon_size = 0
    idle_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 8

# Hulp / critical: amber 3px rand (groen blijft gereserveerd voor git/PR).
[urgency_critical]
    timeout = 0
    frame_color = "#D9A038"
    frame_width = 3
