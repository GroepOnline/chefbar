[Unit]
Description=ChefBar 3.0, ChefGroep agent bar (Rust binary)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# User-unit voor de ingelogde GUI-gebruiker (bijv. joep). User= is bewust
# niet gezet: systemd weigert User= in user-units (exit 216/GROUP).
Type=simple
ExecStart=%h/.local/bin/chefbar
# Quit via tray stuurt exit 0; alleen bij crash herstarten (voorkomt loop na bewust afsluiten).
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Endpoint-profiel is de SSOT voor vault/ops/dashboard/desktop; env-warden
# winnen per veld (zie src/config.rs).
Environment=CHEFBAR_ENDPOINT_PROFILE=%h/.config/chefbar/endpoints.json
# IPC-socket ligt op $XDG_RUNTIME_DIR/chefbar.sock (zie src/ipc.rs). Geen
# RuntimeDirectory nodig — die zou $XDG_RUNTIME_DIR/chefbar/ aanmaken maar de
# socket staat daar niet.
# Control-chat target (default: beste idle Pi; jcode is geheugen, geen chat).
# Voorbeeld: de Pi in Herdr-pane w2R:p2.
# Environment=CHEFBAR_CONTROL_AGENT=w2R:p2
# Environment=CHEFBAR_CONTROL_PANE=w2R:p2

[Install]
WantedBy=graphical-session.target
